{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-mingw-release",
      "displayName": "Windows MinGW Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-mingw-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-mingw-debug",
      "displayName": "Windows MinGW Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-mingw-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux-x11-release",
      "displayName": "Linux X11 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-x11-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "REVDOCK_ENABLE_X11": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-x11-debug",
      "displayName": "Linux X11 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-x11-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "REVDOCK_ENABLE_X11": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ],
  "buildPresets": [
    { "name": "windows-mingw-release", "configurePreset": "windows-mingw-release" },
    { "name": "windows-mingw-debug", "configurePreset": "windows-mingw-debug" },
    { "name": "linux-x11-release", "configurePreset": "linux-x11-release" },
    { "name": "linux-x11-debug", "configurePreset": "linux-x11-debug" }
  ],
  "testPresets": [
    { "name": "windows-mingw-release", "configurePreset": "windows-mingw-release", "output": { "outputOnFailure": true } },
    { "name": "windows-mingw-debug", "configurePreset": "windows-mingw-debug", "output": { "outputOnFailure": true } },
    { "name": "linux-x11-release", "configurePreset": "linux-x11-release", "output": { "outputOnFailure": true } },
    { "name": "linux-x11-debug", "configurePreset": "linux-x11-debug", "output": { "outputOnFailure": true } }
  ]
}
